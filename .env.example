# Copy this file to .env.local and fill in your own values.
# Supabase dashboard -> Project Settings -> API
#
# Add these SAME two variables in Vercel:
#   Project -> Settings -> Environment Variables -> then redeploy.
#
# .env.local is gitignored. Never commit real values.
# Never add the service_role key to this project — it bypasses Row
# Level Security and would let anyone with it read all your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
